# ─── Database ────────────────────────────────────────────────────────────
# Postgres connection string (e.g. from Vercel Postgres, Neon, Supabase, or
# Railway). Without this, the storefront runs on the built-in mock catalog
# (src/lib/data/products.ts) and accounts/checkout persistence/admin are
# disabled with a friendly message.
DATABASE_URL="postgresql://user:password@localhost:5432/lipids"

# ─── Auth.js ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 33
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# ─── Stripe ──────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# https://dashboard.stripe.com/webhooks — required for order persistence
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Cloudinary (admin product image uploads) ───────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Seed script (prisma/seed.ts) ───────────────────────────────────────
SEED_ADMIN_EMAIL="admin@lipids.co"
SEED_ADMIN_PASSWORD="change-me-immediately"
