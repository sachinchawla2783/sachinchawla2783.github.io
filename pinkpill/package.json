{
  "name": "pinkpill",
  "version": "1.0.0",
  "private": true,
  "description": "PinkPill \u2014 a multi-user looksmaxxing forum for women",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "seed:demo": "node server/db/seed.js --demo",
    "create-admin": "node server/scripts/create-admin.js",
    "import:localstorage": "node server/scripts/import-localstorage.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "build": "node server/scripts/check-build.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "supertest": "^7.3.0"
  }
}
