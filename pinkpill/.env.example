# PinkPill configuration. Copy to .env for LOCAL DEVELOPMENT only (production variables are set in
# the Koyeb dashboard). Never commit .env. Placeholders only; no real values belong in this file.
# See DEPLOYMENT.md for what each production value is and where to get it.

# ---------- core ----------
NODE_ENV=development
PORT=3000
# Canonical public URL. Production: https://YOURDOMAIN (all emails and redirects use it).
APP_URL=http://localhost:3000
# Production only: redirect other hostnames / plain HTTP to APP_URL (default: on in production).
# CANONICAL_REDIRECT=
# Number of proxies in front of the app (Koyeb: 1). Default: 1 in production, loopback otherwise.
# TRUST_PROXY=

# ---------- database (PostgreSQL / Neon) ----------
DATABASE_URL=postgres://pinkpill:pinkpill@localhost:5432/pinkpill_dev
DATABASE_URL_TEST=postgres://pinkpill:pinkpill@localhost:5432/pinkpill_test
# TLS is enabled automatically when DATABASE_URL contains sslmode=require (Neon's URLs do).
# DATABASE_SSL=
# DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=15000
# Apply pending migrations when the server starts (default true; uses an advisory lock).
# MIGRATE_ON_START=true

# ---------- sessions ----------
# Sessions are random tokens stored hashed in the database, so no session secret is needed.
# SESSION_DAYS=30
# Leave unset: Secure cookies are forced on in production.
# COOKIE_SECURE=
# Leave unset: email verification is required in production.
# REQUIRE_EMAIL_VERIFICATION=

# ---------- email ----------
# development: file (writes storage/mail/*.txt) | production: resend
MAIL_TRANSPORT=file
MAIL_FROM="PinkPill <no-reply@localhost>"
# Production: from resend.com → API Keys (sending access only).
# RESEND_API_KEY=

# ---------- uploads ----------
# development: local | production: r2
STORAGE_DRIVER=local
STORAGE_DIR=./storage/uploads
# Production (Cloudflare dashboard → R2): account id, bucket name, and an R2 API token scoped to the bucket.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Lifetime of signed image URLs, in seconds.
# MEDIA_URL_TTL_SECONDS=300
# UPLOAD_MAX_BYTES=5242880
# IMAGE_CONCURRENCY=1

# ---------- bot protection (Cloudflare Turnstile) ----------
# Both or neither. The site key is public; the secret key stays on the server.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ON_LOGIN=false

# ---------- first administrator (hosts without a shell) ----------
# A long random value; visit /#/claim-admin once, then delete this variable.
# ADMIN_CLAIM_TOKEN=

# ---------- misc ----------
# RATE_LIMITS=true
# LOG_LEVEL=info
# SHUTDOWN_TIMEOUT_MS=10000
# Development only: password for `npm run seed:demo` members (random if empty).
# SEED_DEMO_PASSWORD=
# docker-compose only: password for the bundled PostgreSQL container.
# POSTGRES_PASSWORD=
