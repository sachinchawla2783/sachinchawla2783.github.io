# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
# Public URL of the site (used in emails and CSRF origin checks). Set your domain here.
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://pinkpill:pinkpill@localhost:5432/pinkpill_dev
DATABASE_URL_TEST=postgres://pinkpill:pinkpill@localhost:5432/pinkpill_test
# Set to true for managed Postgres that requires TLS (e.g. Neon)
DATABASE_SSL=false

# Sessions / cookies
SESSION_DAYS=30
# Secure cookie flag. Leave unset: it defaults to true when NODE_ENV=production (requires HTTPS).
# COOKIE_SECURE=
# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer)
TRUST_PROXY=loopback

# Require users to verify their email before posting. Leave unset: defaults to true in production.
# REQUIRE_EMAIL_VERIFICATION=

# Email: console (prints emails to the log), smtp
MAIL_TRANSPORT=console
MAIL_FROM="PinkPill <no-reply@example.com>"
# smtps://user:password@smtp.example.com:465
SMTP_URL=

# File storage: local (disk, outside the web root) or s3 (any S3-compatible service, e.g. Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_DIR=./storage/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=5242880

# Set to false only for local load testing
RATE_LIMITS=true

# docker-compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=

# `npm run seed:demo` (development only): password for all demo members; random if empty
SEED_DEMO_PASSWORD=

# Only used by the development `file` mail transport (MAIL_TRANSPORT=file)
MAIL_DIR=./storage/mail
