m7bdwqezqkzx","forumId":"f-looks","authorId":"umum7bdwpih0jbj","title":"What was your single biggest looksmax so far?","prefix":"discussion","created":1790101183462,"sticky":false,"locked":false,"views":807,"tags":["discussion"],"poll":null,"watchers":["umum7bdwpih0jbj"]},{"id":"tmum7bdwqrcgccr","forumId":"f-body","authorId":"umum7bdwpdr4hlz","title":"Posture fixes that made the biggest visual difference","prefix":"guide","created":1790170826429,"sticky":false,"locked":false,"views":700,"tags":["posture","body"],"poll":null,"watchers":["umum7bdwpdr4hlz"]},{"id":"tmum7bdwqpkp2ze","forumId":"f-questions","authorId":"umum7bdwphdmnwt","title":"Is it worth seeing a dermatologist for mild acne?","prefix":"question","created":1790227455730,"sticky":false,"locked":false,"views":354,"tags":["acne","dermatology"],"poll":null,"watchers":["umum7bdwphdmnwt"]},{"id":"tmum7bdwqsaowhi","forumId":"f-private-rating","authorId":"umum7bdwpih0jbj","title":"Private: rate my new haircut (members only)","prefix":"rateme","created":1790267882637,"sticky":false,"locked":false,"views":784,"tags":["hair","feedback"],"poll":null,"watchers":["umum7bdwpih0jbj"],"ratingEnabled":true}],"posts":[{"id":"pmum7bdwq7y1jat","threadId":"tmum7bdwpd2lns4","authorId":"umum7bdwppw8vq4","content":"[b]Welcome to PinkPill![/b]\n\nThis is a looksmaxxing community for women: skincare, hair, makeup, fitness, style, facial aesthetics and everything in between.\n\n[b]What makes us different:[/b]\n• Evidence over hype. Cite sources when you can.\n• Feedback is [i]opt-in[/i] and constructive. No bullying, no \"it's over\".\n• Zero tolerance for pro-ED content, DIY injections, bonesmashing or other dangerous practices.\n\nPlease read the [url=#/help/rules]forum rules[/url] and introduce yourself in [url=#/forums/f-intro]Introductions[/url]. ✨\n[img]data:image/png;base64,[/img]","created":1788929624617,"edited":null,"reactions":{"umum7bdwpawap3y":"hug","umum7bdwp3f39kp":"glow","umum7bdwphdmnwt":"wow"},"deleted":false},{"id":"pmum7bdwqpzu1k3","threadId":"tmum7bdwpd2lns4","authorId":"umum7bdwpawap3y","content":"So happy this exists. If you need help with anything, tag @Celeste 💕\n[img]javascript:alert(1)[/img] [url=javascript:alert(1)]x[/url]","created":1788958208312,"edited":null,"reactions":{"umum7bdwp3f39kp":"hug","umum7bdwphdmnwt":"haha"},"deleted":false},{"id":"pmum7bdwq7fty1p","threadId":"tmum7bdwpd2lns4","authorId":"umum7bdwpe9ehth","content":"Finally a place like this that isn't toxic. Thank you!","created":1788979307517,"edited":null,"reactions":{"umum7bdwppw8vq4":"love","umum7bdwpih0jbj":"love"},"deleted":false},{"id":"pmum7bdwq60rc2v","threadId":"tmum7bdwqo2svai","authorId":"umum7bdwppw8vq4","content":"We just shipped:\n\n• [b]Polls[/b] when creating threads\n• [b]Trophies[/b] and ranks\n• [b]Bookmarks[/b] and [b]watched threads[/b]\n• [b]Dark mode[/b] — toggle it in the footer or in your preferences\n\nReport bugs in [url=#/forums/f-feedback]Site Feedback[/url].","created":1789004507517,"edited":null,"reactions":{"umum7bdwpe9ehth":"like","umum7bdwp9hiinj":"haha","umum7bdwpih0jbj":"haha","umum7bdwphdmnwt":"love"},"deleted":false},{"id":"pmum7bdwqhtz9zk","threadId":"tmum7bdwqfrur9l","authorId":"umum7bdwphdmnwt","content":"Been talking to a guy for ~3 weeks. He's sweet in person, but he mostly messages after 11pm and rarely makes plans in advance. Am I overthinking it or is this a red flag?","created":1789043992038,"edited":null,"reactions":{"umum7bdwpawap3y":"glow","umum7bdwpe9ehth":"hug","umum7bdwpih0jbj":"haha"},"deleted":false},{"id":"pmum7bdwq1pij74","threadId":"tmum7bdwqfrur9l","authorId":"umum7bdwpih0jbj","content":"Not overthinking. Consistency during the day and making real plans = interest. Ask him directly for a proper date this weekend and see how he responds.","created":1789074831933,"edited":null,"reactions":{"umum7bdwp3f39kp":"like","umum7bdwphdmnwt":"glow"},"deleted":false},{"id":"pmum7bdwqtyfwwg","threadId":"tmum7bdwqfrur9l","authorId":"umum7bdwpawap3y","content":"Agree with Dahlia. You can say what you want kindly and clearly: \"I'd love to see you Saturday afternoon.\" His response will tell you everything.","created":1789081825756,"edited":null,"reactions":{"umum7bdwppw8vq4":"hug"},"deleted":false},{"id":"pmum7bdwq6kgeom","threadId":"tmum7bdwqfrur9l","authorId":"umum7bdwpe9ehth","content":"And remember you're allowed to want more than a late-night text 💗","created":1789097177179,"edited":null,"reactions":{"umum7bdwpawap3y":"glow","umum7bdwphdmnwt":"like"},"deleted":false},{"id":"pmum7bdwqv3wqvk","threadId":"tmum7bdwq0pwybn","authorId":"umum7bdwpdr4hlz","content":"I've been lifting and eating better and lost some fat. Now every hangout turns into comments about my body, some nice, some weird. How do I set a boundary without being rude?","created":1789122377179,"edited":null,"reactions":{"umum7bdwpawap3y":"love","umum7bdwpih0jbj":"like"},"deleted":false},{"id":"pmum7bdwq0if1bo","threadId":"tmum7bdwq0pwybn","authorId":"umum7bdwp3f39kp","content":"\"Thanks! I'd rather not talk about my body though — how was your week?\" Redirect, every time. People get it fast.","created":1789160132327,"edited":null,"reactions":{"umum7bdwpawap3y":"hug","umum7bdwpe9ehth":"glow","umum7bdwpdr4hlz":"wow","umum7bdwp9hiinj":"love","umum7bdwpih0jbj":"glow"},"deleted":false},{"id":"pmum7bdwqoug87t","threadId":"tmum7bdwqhdcbph","authorId":"umum7bdwphdmnwt","content":"Hi everyone! I'm Freya, 22. Mostly here to learn about skincare and figure out my colour season. Nice to meet you all!","created":1789185332327,"edited":null,"reactions":{"umum7bdwppw8vq4":"hug","umum7bdwpawap3y":"haha","umum7bdwpe9ehth":"like","umum7bdwp3f39kp":"glow","umum7bdwpih0jbj":"love"},"deleted":false},{"id":"pmum7bdwqgng6i2","threadId":"tmum7bdwqhdcbph","authorId":"umum7bdwp3f39kp","content":"Welcome Freya! Post a no-makeup pic in daylight in the colour analysis thread and I'll help you out.","created":1789210591138,"edited":null,"reactions":{},"deleted":false},{"id":"pmum7bdwqe3kwxx","threadId":"tmum7bdwqhdcbph","authorId":"umum7bdwppw8vq4","content":"Welcome aboard 💗","created":1789227978730,"edited":null,"reactions":{"umum7bdwphdmnwt":"haha"},"deleted":false},{"id":"pmum7bdwq38j0uw","threadId":"tmum7bdwqgthx0j","authorId":"umum7bdwpawap3y","content":"[b]The only 3 steps you truly need[/b]\n\n1. [b]Gentle cleanser[/b] (PM, and AM if oily)\n2. [b]Moisturiser[/b] suited to your skin type\n3. [b]Broad-spectrum SPF 30+[/b] every morning, reapplied if outdoors\n\n[b]Then add ONE active at a time:[/b]\n• Retinoid (adapalene / tretinoin / retinal) — anti-aging & acne\n• Azelaic acid — redness, PIH, acne\n• Vitamin C — antioxidant, brightening\n• AHA/BHA — texture, clogged pores\n\n[quote=Celeste]Patch test everything. Introduce actives 2-3 nights a week and build up.[/quote]\n\nSee a dermatologist for persistent acne — prescription options work far better than anything OTC.","created":1789253178730,"edited":null,"reactions":{"umum7bdwppw8vq4":"love","umum7bdwp3f39kp":"like","umum7bdwpdr4hlz":"haha","umum7bdwpih0jbj":"haha","umum7bdwphdmnwt":"love"},"deleted":false},{"id":"pmum7bdwquc1xee","threadId":"tmum7bdwqgthx0j","authorId":"umum7bdwphdmnwt","content":"Saving this! Is it ok to use vitamin C and retinol together?","created":1789284757525,"edited":null,"reactions":{"umum7bdwpe9ehth":"like","umum7bdwpdr4hlz":"hug"},"deleted":false},{"id":"pmum7bdwqg5jo23","threadId":"tmum7bdwqgthx0j","authorId":"umum7bdwpawap3y","content":"@Freya Easiest is Vit C in the morning (under SPF) and retinoid at night. Less irritation.","created":1789295229979,"edited":null,"reactions":{"umum7bdwpe9ehth":"hug","umum7bdwp3f39kp":"glow"},"deleted":false},{"id":"pmum7bdwq4tprgn","threadId":"tmum7bdwqgthx0j","authorId":"umum7bdwpe9ehth","content":"Adapalene changed my skin completely. Purging for ~6 weeks then clear.","created":1789308932292,"edited":null,"reactions":{"umum7bdwppw8vq4":"wow","umum7bdwpdr4hlz":"love","umum7bdwp9hiinj":"love"},"deleted":false},{"id":"pmum7bdwqhks7nz","threadId":"tmum7bdwquxbdvt","authorId":"umum7bdwpdr4hlz","content":"Everything I try either pills under makeup or makes me look greasy by noon. Recommendations?","created":1789334132292,"edited":null,"reactions":{"umum7bdwpe9ehth":"glow","umum7bdwpih0jbj":"hug","umum7bdwphdmnwt":"haha"},"deleted":false},{"id":"pmum7bdwq4u7bkg","threadId":"tmum7bdwquxbdvt","authorId":"umum7bdwp3f39kp","content":"Look for fluid/gel textures. Let it set 5-10 min before makeup and use a silicone-free primer if it pills.","created":1789360169592,"edited":null,"reactions":{"umum7bdwppw8vq4":"haha","umum7bdwpe9ehth":"haha","umum7bdwp9hiinj":"haha","umum7bdwpih0jbj":"hug","umum7bdwphdmnwt":"haha"},"deleted":false},{"id":"pmum7bdwqmjdd5p","threadId":"tmum7bdwquxbdvt","authorId":"umum7bdwpawap3y","content":"Asian and EU formulas tend to be more elegant. Also, pilling is often from layering too many products — simplify.","created":1789369618329,"edited":null,"reactions":{"umum7bdwp3f39kp":"like"},"deleted":false},{"id":"pmum7bdwqyh5v62","threadId":"tmum7bdwqrlken7","authorId":"umum7bdwpe9ehth","content":"Routine:\n• Scalp massage 5 min daily\n• Gentle sulfate-free shampoo, 3x/week\n• Silk pillowcase\n• Minimised heat, low-tension hairstyles\n• Iron & vit D bloodwork checked with my GP\n\nMonth 12 update coming soon! [spoiler]Gained about 14cm and much less breakage.[/spoiler]","created":1789394818329,"edited":null,"reactions":{"umum7bdwppw8vq4":"haha","umum7bdwp3f39kp":"haha","umum7bdwp9hiinj":"love"},"deleted":false},{"id":"pmum7bdwqc8so7k","threadId":"tmum7bdwqrlken7","authorId":"umum7bdwphdmnwt","content":"Amazing progress! Did you use any oils?","created":1789409097703,"edited":null,"reactions":{"umum7bdwppw8vq4":"love"},"deleted":false},{"id":"pmum7bdwq011uxz","threadId":"tmum7bdwqrlken7","authorId":"umum7bdwpe9ehth","content":"Rosemary oil on and off. Honestly the bloodwork + lower heat made the biggest difference.","created":1789420786919,"edited":null,"reactions":{"umum7bdwpdr4hlz":"love","umum7bdwp9hiinj":"hug","umum7bdwphdmnwt":"like"},"deleted":false},{"id":"pmum7bdwq42hdnt","threadId":"tmum7bdwqvt9gu6","authorId":"umum7bdwp3f39kp","content":"Post a [b]no-makeup photo in natural daylight[/b] (face + neck, hair pulled back) and I'll give my best guess on your season.\n\n[b]Quick self-test:[/b]\n• Veins greenish → warm; bluish → cool\n• Gold or silver jewellery flatters more?\n• Pure white or off-white near your face?\n\nRemember this is a tool, not a rule. Wear what makes you happy.","created":1789445986919,"edited":null,"reactions":{"umum7bdwpawap3y":"hug","umum7bdwp9hiinj":"glow","umum7bdwpih0jbj":"wow","umum7bdwphdmnwt":"haha"},"deleted":false},{"id":"pmum7bdwq05emxf","threadId":"tmum7bdwqvt9gu6","authorId":"umum7bdwpih0jbj","content":"I was typed as Deep Autumn and my whole wardrobe makes sense now lol","created":1789475547814,"edited":null,"reactions":{"umum7bdwp3f39kp":"wow"},"deleted":false},{"id":"pmum7bdwqh7lgnl","threadId":"tmum7bdwqgbl1g8","authorId":"umum7bdwpdr4hlz","content":"3x per week, full body:\n\n• Hip thrust 3x8-12\n• Romanian deadlift 3x8-10\n• Goblet squat 3x10\n• Face pulls 3x15 (posture!)\n• Dead bugs 3x10\n\nProgressive overload is everything. Eat enough protein (~1.6g/kg).","created":1789500747814,"edited":null,"reactions":{"umum7bdwppw8vq4":"like","umum7bdwpawap3y":"hug","umum7bdwpe9ehth":"wow","umum7bdwp9hiinj":"hug","umum7bdwphdmnwt":"hug"},"deleted":false},{"id":"pmum7bdwqyaa9pn","threadId":"tmum7bdwqgbl1g8","authorId":"umum7bdwp9hiinj","content":"Face pulls are so underrated for rounded shoulders.","created":1789517318342,"edited":null,"reactions":{"umum7bdwppw8vq4":"like","umum7bdwpe9ehth":"wow","umum7bdwpdr4hlz":"wow","umum7bdwphdmnwt":"love"},"deleted":false},{"id":"pmum7bdwqbdmci1","threadId":"tmum7bdwqgbl1g8","authorId":"umum7bdwphdmnwt","content":"Starting this Monday 💪","created":1789529871232,"edited":null,"reactions":{"umum7bdwpdr4hlz":"wow","umum7bdwpih0jbj":"haha"},"deleted":false},{"id":"pmum7bdwqlxa4g5","threadId":"tmum7bdwqn9x9hm","authorId":"umum7bdwpawap3y","content":"Very low calorie diets cause muscle loss, hair shedding (telogen effluvium), fatigue and often rebound weight gain.\n\n[b]Sustainable approach:[/b]\n• Modest deficit if fat loss is the goal (~300-500 kcal)\n• Protein at every meal\n• Resistance training to keep muscle\n• Sleep 7-9h\n\nIf you're struggling with food or body image, please see the pinned resources in [url=#/forums/f-wellbeing]Mental Health & Confidence[/url].","created":1789555071232,"edited":null,"reactions":{"umum7bdwpe9ehth":"glow","umum7bdwp3f39kp":"love","umum7bdwpdr4hlz":"glow"},"deleted":false},{"id":"pmum7bdwq2ooxuw","threadId":"tmum7bdwqn9x9hm","authorId":"umum7bdwpe9ehth","content":"The hair shedding part is so real. Lost a ton after a crash diet in 2023.","created":1789581879847,"edited":null,"reactions":{"umum7bdwpawap3y":"like","umum7bdwp3f39kp":"like","umum7bdwphdmnwt":"haha"},"deleted":false},{"id":"pmum7bdwqivsnrl","threadId":"tmum7bdwq0cmjyq","authorId":"umum7bdwp9hiinj","content":"Summary of what the evidence says:\n\n• [b]Adults:[/b] tongue posture alone won't reshape bone. Orthodontics/orthognathic surgery can.\n• [b]Head/neck posture[/b] affects how your jawline photographs a lot.\n• [b]Body fat[/b] & [b]water retention[/b] change facial definition.\n• [b]Brows, hair framing and makeup contour[/b] give the fastest visible change.\n\nAnd to be crystal clear: never try any \"DIY\" bone or jaw hacks. See an orthodontist or maxillofacial surgeon.","created":1789607079847,"edited":null,"reactions":{"umum7bdwppw8vq4":"hug","umum7bdwpe9ehth":"hug","umum7bdwp3f39kp":"glow","umum7bdwpdr4hlz":"wow","umum7bdwphdmnwt":"hug"},"deleted":false},{"id":"pmum7bdwqnrljql","threadId":"tmum7bdwq0cmjyq","authorId":"umum7bdwphdmnwt","content":"Didn't know head posture made such a difference in photos. Tried it, wow.","created":1789630108765,"edited":null,"reactions":{"umum7bdwpdr4hlz":"glow","umum7bdwp9hiinj":"glow"},"deleted":false},{"id":"pmum7bdwqu0qm78","threadId":"tmum7bdwqovkqme","authorId":"umum7bdwpih0jbj","content":"Pick 2 neutrals + 1-2 accent colours from your season. Then:\n\n• 5 tops, 3 knits, 4 bottoms, 2 dresses\n• 2 jackets, 1 coat\n• 4 pairs of shoes\n• Accessories to taste\n\nFit > brand. A good tailor is the ultimate looksmax.","created":1789655308765,"edited":null,"reactions":{"umum7bdwpawap3y":"hug","umum7bdwpdr4hlz":"hug","umum7bdwp9hiinj":"haha","umum7bdwphdmnwt":"wow"},"deleted":false},{"id":"pmum7bdwqbbmmsr","threadId":"tmum7bdwqysp5p1","authorId":"umum7bdwpawap3y","content":"• Board-certified (dermatology / plastic surgery) — verify on the official registry\n• Consultation before any treatment, with risks explained\n• Uses licensed products and can tell you the batch number\n• Has a plan for complications (e.g. hyaluronidase on hand for fillers)\n• Never pressures you\n\n[b]Never buy fillers or botox online to self-inject.[/b] It can cause blindness and necrosis.","created":1789694800843,"edited":null,"reactions":{"umum7bdwppw8vq4":"glow","umum7bdwp3f39kp":"love","umum7bdwpih0jbj":"like"},"deleted":false},{"id":"pmum7bdwqkvy2oo","threadId":"tmum7bdwqih25ma","authorId":"umum7bdwphdmnwt","content":"Here's me, no makeup, daylight. What would you focus on first?\n\n[i](image removed in demo)[/i]","created":1789726262036,"edited":null,"reactions":{"umum7bdwppw8vq4":"wow","umum7bdwpawap3y":"wow","umum7bdwpe9ehth":"love","umum7bdwpdr4hlz":"haha"},"deleted":false,"rating":null},{"id":"pmum7bdwqe987po","threadId":"tmum7bdwqih25ma","authorId":"umum7bdwp3f39kp","content":"You have lovely eyes! Brows a touch fuller would frame your face more. Try a tinted brow gel.","created":1789745045027,"edited":null,"reactions":{"umum7bdwphdmnwt":"hug"},"deleted":false,"rating":7},{"id":"pmum7bdwqw9wwel","threadId":"tmum7bdwqih25ma","authorId":"umum7bdwpdr4hlz","content":"Great skin. I'd try a curtain bang — would suit your face shape.","created":1789766632276,"edited":null,"reactions":{"umum7bdwphdmnwt":"wow"},"deleted":false,"rating":7},{"id":"pmum7bdwqydfyj4","threadId":"tmum7bdwqih25ma","authorId":"umum7bdwpih0jbj","content":"Warm-toned blush and a slightly lighter hair colour would brighten everything up!","created":1789787856671,"edited":null,"reactions":{"umum7bdwppw8vq4":"glow","umum7bdwpawap3y":"hug","umum7bdwp3f39kp":"haha","umum7bdwpdr4hlz":"glow"},"deleted":false,"rating":8},{"id":"pmum7bdwqm8uoha","threadId":"tmum7bdwqlj8gku","authorId":"umum7bdwpe9ehth","content":"Dermatologist → adapalene + azelaic acid + boring moisturiser + SPF. That's it. Took 8 months and a lot of patience.\n\nThank you all for the support in my old thread! 💗","created":1789813056671,"edited":null,"reactions":{"umum7bdwp3f39kp":"wow","umum7bdwp9hiinj":"haha","umum7bdwpih0jbj":"love","umum7bdwphdmnwt":"hug"},"deleted":false},{"id":"pmum7bdwqll8i4a","threadId":"tmum7bdwqlj8gku","authorId":"umum7bdwpawap3y","content":"This is what we love to see. Congrats!","created":1789842997315,"edited":null,"reactions":{"umum7bdwpdr4hlz":"glow","umum7bdwp9hiinj":"glow"},"deleted":false},{"id":"pmum7bdwq2pmicv","threadId":"tmum7bdwqlj8gku","authorId":"umum7bdwppw8vq4","content":"Incredible progress 🏆","created":1789863369795,"edited":null,"reactions":{"umum7bdwpdr4hlz":"love","umum7bdwphdmnwt":"love"},"deleted":false},{"id":"pmum7bdwqq0lq8b","threadId":"tmum7bdwq0va4sm","authorId":"umum7bdwppw8vq4","content":"If you're struggling, you're not alone and you deserve help.\n\n• [b]Emergency:[/b] call your local emergency number\n• [b]US:[/b] 988 Suicide & Crisis Lifeline (call or text 988)\n• [b]UK & ROI:[/b] Samaritans 116 123\n• [b]Eating disorders:[/b] NEDA (US), Beat (UK) 0808 801 0677\n• [b]International:[/b] findahelpline.com\n\nThis forum is peer support, not a replacement for professional care.","created":1789888569795,"edited":null,"reactions":{"umum7bdwpawap3y":"wow","umum7bdwp3f39kp":"wow","umum7bdwpdr4hlz":"wow","umum7bdwphdmnwt":"glow"},"deleted":false},{"id":"pmum7bdwqgxi9m8","threadId":"tmum7bdwqctvjgj","authorId":"umum7bdwpdr4hlz","content":"Some days I spend more time looking at other people than working on myself. How do you deal with it?","created":1789919657226,"edited":null,"reactions":{"umum7bdwppw8vq4":"haha","umum7bdwphdmnwt":"like"},"deleted":false},{"id":"pmum7bdwq9rv2wk","threadId":"tmum7bdwqctvjgj","authorId":"umum7bdwpawap3y","content":"Curating my feed helped a lot. Unfollow anything that makes you feel worse, follow people who teach something.","created":1789930523019,"edited":null,"reactions":{},"deleted":false},{"id":"pmum7bdwqv7ptza","threadId":"tmum7bdwqctvjgj","authorId":"umum7bdwpih0jbj","content":"Remind yourself most photos are filtered/edited/angled. Compare you to you from last year instead.","created":1789935273089,"edited":null,"reactions":{},"deleted":false},{"id":"pmum7bdwqar9lw7","threadId":"tmum7bdwq8of1qj","authorId":"umum7bdwpih0jbj","content":"Drop your current song 🎧","created":1789960473089,"edited":null,"reactions":{"umum7bdwppw8vq4":"haha","umum7bdwpawap3y":"like","umum7bdwpe9ehth":"hug","umum7bdwpdr4hlz":"haha","umum7bdwp9hiinj":"haha"},"deleted":false},{"id":"pmum7bdwqxcjo77","threadId":"tmum7bdwq8of1qj","authorId":"umum7bdwpdr4hlz","content":"Gym playlist on repeat lol","created":1789984244596,"edited":null,"reactions":{"umum7bdwppw8vq4":"haha","umum7bdwpawap3y":"wow","umum7bdwpih0jbj":"wow"},"deleted":false},{"id":"pmum7bdwqypx0do","threadId":"tmum7bdwq8of1qj","authorId":"umum7bdwpe9ehth","content":"Lo-fi while doing my hair mask","created":1789990329020,"edited":null,"reactions":{"umum7bdwp9hiinj":"love","umum7bdwpih0jbj":"love","umum7bdwphdmnwt":"like"},"deleted":false},{"id":"pmum7bdwqjerdlg","threadId":"tmum7bdwqmhhax8","authorId":"umum7bdwphdmnwt","content":"Would love a before/after slider in glow-up threads!","created":1790015529020,"edited":null,"reactions":{"umum7bdwppw8vq4":"like","umum7bdwpawap3y":"like","umum7bdwpe9ehth":"like","umum7bdwp3f39kp":"like","umum7bdwpdr4hlz":"like","umum7bdwp9hiinj":"wow","umum7bdwpih0jbj":"glow"},"deleted":false},{"id":"pmum7bdwqe52e1l","threadId":"tmum7bdwqmhhax8","authorId":"umum7bdwppw8vq4","content":"Added to the roadmap 💗","created":1790032191777,"edited":null,"reactions":{},"deleted":false},{"id":"pmum7bdwqs2jpfb","threadId":"tmum7bdwqmao9lk","authorId":"umum7bdwppw8vq4","content":"A randomised trial summary making the rounds again: participants who applied broad-spectrum sunscreen [b]daily[/b] showed significantly less photoaging over 4.5 years than those who used it at their own discretion.\n\nTakeaway: the best anti-aging product is still the one you wear every morning. Discuss in [url=#/forums/f-skin]Skincare[/url].","created":1790057391777,"edited":null,"reactions":{"umum7bdwpe9ehth":"haha","umum7bdwp3f39kp":"haha","umum7bdwpih0jbj":"love"},"deleted":false},{"id":"pmum7bdwqle2rhl","threadId":"tmum7bdwqmao9lk","authorId":"umum7bdwpawap3y","content":"The classic Nambour trial! Always worth re-sharing.","created":1790075983462,"edited":null,"reactions":{"umum7bdwpdr4hlz":"wow"},"deleted":false},{"id":"pmum7bdwq7zn3ja","threadId":"tmum7bdwqezqkzx","authorId":"umum7bdwpih0jbj","content":"For me it was getting my brows shaped professionally. Changed my whole face. What about you?","created":1790101183462,"edited":null,"reactions":{"umum7bdwppw8vq4":"wow","umum7bdwpawap3y":"love","umum7bdwpe9ehth":"glow","umum7bdwpdr4hlz":"wow","umum7bdwp9hiinj":"wow"},"deleted":false},{"id":"pmum7bdwqnwum2s","threadId":"tmum7bdwqezqkzx","authorId":"umum7bdwpe9ehth","content":"Fixing my sleep. Skin, under-eyes, mood — everything improved.","created":1790120238974,"edited":null,"reactions":{"umum7bdwpih0jbj":"glow"},"deleted":false},{"id":"pmum7bdwqgt6o8i","threadId":"tmum7bdwqezqkzx","authorId":"umum7bdwpdr4hlz","content":"Lifting. Posture + shoulders changed how clothes fit completely.","created":1790124407610,"edited":null,"reactions":{"umum7bdwpawap3y":"haha","umum7bdwp3f39kp":"glow","umum7bdwp9hiinj":"glow"},"deleted":false},{"id":"pmum7bdwqb7xj1r","threadId":"tmum7bdwqezqkzx","authorId":"umum7bdwphdmnwt","content":"Finding my colour season 💗","created":1790145626429,"edited":null,"reactions":{"umum7bdwpih0jbj":"love"},"deleted":false},{"id":"pmum7bdwqyv0w31","threadId":"tmum7bdwqrcgccr","authorId":"umum7bdwpdr4hlz","content":"• Chin tucks (2x10 daily)\n• Wall angels\n• Face pulls & rows > pressing for a while\n• Hip flexor stretches if you sit all day\n\nTake a side-profile photo now and in 8 weeks. You'll be surprised.","created":1790170826429,"edited":null,"reactions":{"umum7bdwpawap3y":"hug","umum7bdwp3f39kp":"glow","umum7bdwpih0jbj":"wow","umum7bdwphdmnwt":"glow"},"deleted":false},{"id":"pmum7bdwqa782nl","threadId":"tmum7bdwqrcgccr","authorId":"umum7bdwp9hiinj","content":"Adding thoracic extensions over a foam roller — game changer.","created":1790202255730,"edited":null,"reactions":{"umum7bdwp3f39kp":"like","umum7bdwphdmnwt":"like"},"deleted":false},{"id":"pmum7bdwq96kb3e","threadId":"tmum7bdwqpkp2ze","authorId":"umum7bdwphdmnwt","content":"My acne isn't severe but it never fully goes away. Is a derm overkill?","created":1790227455730,"edited":null,"reactions":{"umum7bdwppw8vq4":"wow","umum7bdwpawap3y":"love","umum7bdwpe9ehth":"glow","umum7bdwp9hiinj":"hug"},"deleted":false},{"id":"pmum7bdwq5w3bqf","threadId":"tmum7bdwqpkp2ze","authorId":"umum7bdwpawap3y","content":"Not overkill at all. Prescription topicals (adapalene, azelaic acid, clindamycin, etc.) are cheap and much more effective than guessing with OTC products.","created":1790242682637,"edited":null,"reactions":{},"deleted":false},{"id":"pmum7bdwq34iobw","threadId":"tmum7bdwqsaowhi","authorId":"umum7bdwpih0jbj","content":"Posting here since it's hidden from guests. Went from long layers to a collarbone bob. Thoughts?\n\n[i](image removed in demo)[/i]","created":1790267882637,"edited":null,"reactions":{"umum7bdwpdr4hlz":"glow"},"deleted":false},{"id":"pmum7bdwq4x2r6r","threadId":"tmum7bdwqsaowhi","authorId":"umum7bdwp3f39kp","content":"Suits your jaw so well! Maybe a slightly warmer gloss next time.","created":1790310301681,"edited":null,"reactions":{"umum7bdwpih0jbj":"love"},"deleted":false,"rating":8},{"id":"pmum7bdwq1szivl","threadId":"tmum7bdwqsaowhi","authorId":"umum7bdwpe9ehth","content":"The length is perfect for you.","created":1790316589362,"edited":null,"reactions":{"umum7bdwp9hiinj":"glow","umum7bdwphdmnwt":"glow"},"deleted":false,"rating":8}],"profilePosts":[{"id":"ppmum7bdwqnqde0a","profileUserId":"umum7bdwphdmnwt","authorId":"umum7bdwp3f39kp","content":"Welcome to PinkPill! 💕","created":1790398424617,"reactions":{"umum7bdwphdmnwt":"love"},"comments":[{"id":"pcmum7bdwqdek1yy","authorId":"umum7bdwphdmnwt","content":"Thank you!!","created":1790402024617}]},{"id":"ppmum7bdwqg1kicr","profileUserId":"umum7bdwpe9ehth","authorId":"umum7bdwpdr4hlz","content":"Your hair log is so motivating!","created":1790484824617,"reactions":{},"comments":[]}],"conversations":[],"alerts":[],"reports":[],"settings":{"siteName":"PinkPill","created":1790657624617}}